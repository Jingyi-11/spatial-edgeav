# Spatial EdgeAV RK3576 service defaults.
# Installed on the board as /etc/spatial-edgeav/rknn.env.

EDGEAV_ROOT=/home/kickpi/spatial-edgeav
EDGEAV_MODEL=/home/kickpi/spatial-edgeav/models/yolov8n/yolov8n_rockchip_rk3576_i8.rknn
EDGEAV_CAMERA=/dev/video73
EDGEAV_WIDTH=1280
EDGEAV_HEIGHT=720
EDGEAV_FPS=30
EDGEAV_IMAGE_SIZE=640
EDGEAV_CONF_THRES=0.25
EDGEAV_IOU_THRES=0.45
EDGEAV_STATUS_INTERVAL_SEC=10
EDGEAV_MAX_FRAME_RECORDS=300
