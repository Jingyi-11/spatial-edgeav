# Spatial EdgeAV C/C++ RK3576 service defaults.
# Installed on the board as /etc/spatial-edgeav/cpp.env.

EDGEAV_ROOT=/home/kickpi/spatial-edgeav
EDGEAV_CPP_RUNTIME=/home/kickpi/spatial-edgeav/cpp_runtime_src/build/edgeav_runtime
EDGEAV_MODEL=/home/kickpi/spatial-edgeav/models/yolov8n/yolov8n_rockchip_rk3576_i8.rknn
EDGEAV_CAMERA=/dev/video73
EDGEAV_WIDTH=1280
EDGEAV_HEIGHT=720
EDGEAV_FPS=30
EDGEAV_FORMAT=MJPEG
EDGEAV_FRAMES=0
EDGEAV_MAX_FRAME_RECORDS=300
EDGEAV_SPATIAL_RULES=/home/kickpi/spatial-edgeav/configs/spatial_rules.json
